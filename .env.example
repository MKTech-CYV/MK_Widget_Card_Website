NEXT_PUBLIC_SITE_URL=https://mktechvn.com

# Firebase web config is public and has built-in defaults for project
# mk-widget-card-84 (see src/lib/firebase/client.ts). Only set these to
# point the site at a different Firebase project.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only secret (Vercel env, mark as Sensitive). Firebase Console >
# Project settings > Service accounts > Generate new private key. Paste the
# JSON as-is or base64-encoded. NEVER commit the key file.
FIREBASE_SERVICE_ACCOUNT_JSON=
